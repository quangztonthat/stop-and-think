<style>
:root {
  --ink: #1a1410;
  --paper: #ffffff;
  --paper-dark: #f7f7f7;
  --accent: #2d4a5c;
  --accent-deep: #1f3340;
  --accent-2: #8b3a2b;
  --navy: #2d4a5c;
  --gold: #c4923c;
  --muted: #3d3d3d;
  --line: #5e2418;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
h1, h2, h3, h4, h5, .nav-brand, .footer-brand, .brand, .cover-brand, .cat-title, .book-cover-title, .book-title, .book-card-title, .cover-title, .chap-title, .chapter-title, .fw-name, .compare-name, .law-name, .principle h3 { font-family: 'Fraunces', Georgia, serif; }

em { font-style: normal; }
html { scroll-behavior: smooth; }
body { background: var(--paper); color: var(--ink); font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 19px; line-height: 1.65; overflow-x: hidden; }

.nav-bar { position: fixed; top: 0; left: 0; right: 0; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(26, 20, 16, 0.1); z-index: 100; padding: 14px 32px; display: flex; justify-content: space-between; align-items: center; }
.nav-logo { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; text-decoration: none; color: var(--ink); }
.nav-logo span { color: var(--accent-2); }
.nav-logo em { font-style: normal; color: var(--accent); font-weight: 400; font-size: 22px; vertical-align: -2px; }
.nav-links { display: flex; gap: 28px; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; }
.nav-links a { color: var(--muted); text-decoration: none; cursor: pointer; transition: color 0.2s; }
.nav-links a:hover { color: var(--accent-2); }
.lang-switch { display: inline-flex; gap: 6px; align-items: center; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.1em; margin-left: 16px; }
.lang-switch a { color: var(--muted); padding: 4px 6px; text-decoration: none; transition: color 0.2s; }
.lang-switch a.active { color: var(--ink); font-weight: 600; }
.lang-switch a:hover { color: var(--rust); }
.lang-switch .sep { opacity: 0.4; }

.nav-links a.active { color: var(--accent-2); font-weight: 600; }

.hero { min-height: 80vh; padding: 140px 8% 80px; display: grid; grid-template-columns: 1.2fr 1fr; gap: 80px; align-items: center; border-bottom: 2px solid var(--ink); }
.hero-meta { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-bottom: 24px; display: flex; gap: 16px; align-items: center; }
.hero-meta::before { content: ''; width: 40px; height: 1px; background: var(--accent); }
.hero h1 { font-size: clamp(56px, 9vw, 132px); font-weight: 500; line-height: 0.95; letter-spacing: -0.04em; margin-bottom: 32px; }
.hero h1 em { font-style: normal; color: var(--accent-2); font-weight: 700; }
.hero-tagline { font-size: 22px; font-weight: 400; color: var(--muted); max-width: 560px; line-height: 1.5; }
.hero-tagline strong { color: var(--accent-2); font-weight: 500; }

.hero-visual { position: relative; min-height: 460px; display: flex; align-items: center; justify-content: center; }
.hero-svg-wrap { position: relative; width: 100%; max-width: 420px; aspect-ratio: 1; }
.hero-svg-wrap svg { width: 100%; height: 100%; }

.section { padding: 100px 8%; border-bottom: 1px solid rgba(26, 20, 16, 0.15); }
.section-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent-2); margin-bottom: 24px; display: flex; align-items: center; gap: 12px; }
.section-label::before { content: '◆'; }
.section-title { font-size: clamp(38px, 5.5vw, 64px); font-weight: 700; line-height: 1.1; letter-spacing: -0.025em; margin-bottom: 32px; max-width: 1000px; }
.section-title em { font-style: normal; color: var(--accent-2); }
/* Thesis section — magazine spread layout */
.thesis-spread { padding-top: 72px; padding-bottom: 72px; }
.thesis-spread-header { text-align: center; max-width: 1100px; margin: 0 auto 48px; }
.thesis-spread-header .section-label { margin-bottom: 16px; }
.thesis-title-spread {
  font-family: 'Fraunces', Georgia, serif;
  font-size: clamp(22px, 2.8vw, 34px);
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -0.015em;
  margin: 0;
  color: var(--ink);
}
.thesis-spread-viz {
  width: 100%;
  max-width: 960px;
  margin: 0 auto 64px;
  aspect-ratio: 16 / 9;
}
.thesis-spread-viz svg { width: 100%; height: 100%; display: block; overflow: visible; }
.thesis-spread-body {
  columns: 2;
  column-gap: 64px;
  column-fill: balance;
  max-width: 880px;
  margin: 0 auto;
}
.thesis-spread-body .section-intro:first-child { margin-top: 0; }
.thesis-spread-body .section-intro {
  break-inside: avoid;
  margin-bottom: 24px;
}
.thesis-spread-body .section-intro:last-child { margin-bottom: 0; }
.thesis-spread-body .section-intro {
  font-size: 19px;
  line-height: 1.75;
  color: var(--muted, #4a3f33);
  margin: 0;
  max-width: none;
}
@media (max-width: 800px) {
  .thesis-spread-body { columns: 1; }
  .thesis-spread-viz { margin-bottom: 36px; }
  .thesis-spread-header { margin-bottom: 28px; }
}

.section-intro { font-size: 20px; color: var(--muted); line-height: 1.55; font-weight: 400; max-width: 760px; margin-bottom: 40px; }
.section-intro strong { color: var(--accent-2); font-weight: 500; }

.thesis-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; max-width: 1300px; }
.thesis-title-small { font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 24px; }
.thesis-title-small em { font-style: normal; color: var(--accent-2); }
.thesis-viz { position: relative; width: 100%; max-width: 480px; aspect-ratio: 1; margin: 0 auto; }
.thesis-viz svg { width: 100%; height: 100%; overflow: visible; }

.thesis-quote { background: var(--ink); color: var(--paper); padding: 48px 8%; position: relative; }
.thesis-mark { font-size: 56px; line-height: 0.8; color: var(--accent); margin-bottom: 10px; }
.thesis-text { font-size: clamp(22px, 2.5vw, 30px); font-weight: 400; line-height: 1.4; max-width: 880px; }
.thesis-text em { font-style: normal; color: var(--accent); font-weight: 500; }
.thesis-author { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); margin-top: 24px; }

/* Framework cards */
.fw-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; margin: 48px 0; }
.fw-card { padding: 36px 32px; border: 2px solid var(--ink); background: var(--paper-dark); position: relative; }
.fw-num { font-size: 64px; font-weight: 400; line-height: 0.9; color: var(--accent); margin-bottom: 12px; }
.fw-name { font-size: 24px; font-weight: 700; line-height: 1.2; margin-bottom: 16px; }
.fw-name em { font-style: normal; color: var(--accent-2); }
.fw-tag { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent-2); margin-bottom: 16px; }
.fw-desc { font-size: 16px; line-height: 1.6; margin-bottom: 16px; }
.fw-extra { padding: 12px 14px; background: var(--paper); border-left: 3px solid var(--accent); font-size: 14px; line-height: 1.55; }
.fw-extra strong { color: var(--accent-2); }

/* Compare cards */
.compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin: 48px 0; }
.compare-card { padding: 36px 32px; }
.compare-card.a { background: var(--accent-2); color: var(--paper); border: 2px solid var(--line); }
.compare-card.b { background: var(--navy); color: var(--paper); border: 2px solid var(--ink); }
.compare-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.7; margin-bottom: 12px; }
.compare-name { font-size: 22px; font-weight: 700; line-height: 1.2; margin-bottom: 16px; }
.compare-desc { font-size: 16px; line-height: 1.6; margin-bottom: 16px; }
.compare-quote { padding: 16px; background: rgba(0,0,0,0.06); font-size: 14px; line-height: 1.55; }
.compare-card.b .compare-quote { background: rgba(255,255,255,0.08); }

/* Chapter map */
.chap-list { display: grid; gap: 16px; max-width: 880px; margin: 40px 0; }
.chap-row { display: grid; grid-template-columns: 100px 1fr; gap: 24px; padding: 22px 28px; background: var(--paper-dark); border-left: 3px solid var(--accent); align-items: start; }
.rule-section { padding: 60px 0; border-top: 1px solid var(--ink-light, #d6cfc2); }
.rule-section:first-of-type { border-top: none; padding-top: 32px; }
.rule-header { margin-bottom: 32px; }
.rule-num { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.15em; color: var(--accent-2); margin-bottom: 12px; text-transform: uppercase; }
.rule-title { font-size: clamp(28px, 4vw, 40px); font-weight: 700; line-height: 1.15; margin-bottom: 14px; }
.rule-sub { font-size: 16px; line-height: 1.5; color: var(--muted); max-width: 720px; }
.chapter-grid {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  padding: 4px 8% 24px 0;
  scroll-snap-type: x mandatory;
  margin-left: -4px;
}
.chapter-grid::-webkit-scrollbar { height: 8px; }
.chapter-grid::-webkit-scrollbar-track { background: rgba(26, 20, 16, 0.05); border-radius: 4px; }
.chapter-grid::-webkit-scrollbar-thumb { background: var(--accent, var(--rust, #8b3a2b)); border-radius: 4px; }
.chapter-grid::-webkit-scrollbar-thumb:hover { background: var(--ink); }
.chapter-card {
  flex: 0 0 320px;
  scroll-snap-align: start;
  display: flex;
  flex-direction: column; padding: 24px; background: rgba(196, 146, 60, 0.04); border: 1px solid rgba(26, 20, 16, 0.08); transition: all 0.2s; }
.chapter-card:hover { background: rgba(196, 146, 60, 0.08); border-color: rgba(26, 20, 16, 0.18); }
.chapter-num { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.15em; color: var(--accent-2); margin-bottom: 8px; }
.chapter-title { font-size: 19px; font-weight: 600; line-height: 1.3; margin-bottom: 8px; }
.chapter-desc { font-size: 14px; line-height: 1.55; color: var(--muted); }
.chapter-tabs { display: flex; gap: 8px; margin-bottom: 32px; flex-wrap: wrap; justify-content: center; }
.chapter-tab-btn { padding: 10px 16px; background: transparent; border: 1.5px solid var(--ink); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; transition: all 0.2s; color: var(--ink); }
.chapter-tab-btn.active, .chapter-tab-btn:hover { background: var(--ink); color: var(--paper); }
.chap-list, .chap-row, .chap-num, .chap-title, .chap-desc { display: none !important; }

/* Flashcards */
.flashcards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin: 32px 0; }
.flashcard { background: var(--paper-dark); border: 1.5px solid var(--ink); padding: 24px; cursor: pointer; transition: all 0.3s; min-height: 160px; display: flex; flex-direction: column; justify-content: space-between; }
.flashcard:hover { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--accent-2); }
.flashcard-num { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.2em; color: var(--accent-2); margin-bottom: 12px; }
.flashcard-front { font-size: 17px; font-weight: 600; line-height: 1.3; }
.flashcard-back { font-size: 14px; line-height: 1.55; color: var(--muted); margin-top: 14px; padding-top: 14px; border-top: 1px dashed rgba(26, 20, 16, 0.2); }

/* Journal */
.journal-section { background: var(--ink); color: var(--paper); padding: 80px 8%; }
.journal-section .section-label { color: var(--accent); }
.journal-section .section-title { color: var(--paper); }
.journal-section .section-intro { color: rgba(255, 255, 255, 0.8); }
.journal-prompts { display: grid; gap: 24px; max-width: 880px; margin: 32px 0; }
.journal-prompt { padding: 24px 28px; background: rgba(255, 255, 255, 0.06); border-left: 3px solid var(--accent); }
.journal-prompt-num { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.2em; color: var(--accent); margin-bottom: 8px; }
.journal-prompt-text { font-size: 18px; font-weight: 400; line-height: 1.4; }
.journal-prompt-hint { font-size: 13px; line-height: 1.55; color: rgba(255, 255, 255, 0.6); margin-top: 8px; }
.journal-prompts-nav { display: flex; gap: 8px; margin-bottom: 24px; justify-content: center; flex-wrap: wrap; }
.journal-dot { width: 36px; height: 36px; border: 1.5px solid var(--paper, #f5ede0); display: flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace; font-size: 13px; cursor: pointer; transition: all 0.2s; color: var(--paper, #f5ede0); }
.journal-dot.active, .journal-dot:hover { background: var(--paper, #f5ede0); color: var(--ink, #1a1410); }
.journal-prompt-q { font-family: 'Fraunces', Georgia, serif; font-size: 22px; line-height: 1.4; font-weight: 500; margin-bottom: 12px; color: var(--paper, #f5ede0); }
.journal-prompt-help { font-size: 14px; line-height: 1.55; color: rgba(255, 255, 255, 0.7); margin: 8px 0 16px; }
.journal-textarea { width: 100%; min-height: 140px; padding: 14px 16px; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2); color: var(--paper, #f5ede0); font-family: 'Fraunces', Georgia, serif; font-size: 15px; line-height: 1.55; resize: vertical; }
.journal-textarea:focus { outline: none; border-color: var(--accent); background: rgba(255, 255, 255, 0.12); }
.journal-actions { display: flex; gap: 12px; align-items: center; margin-top: 12px; }
.journal-saved { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.18em; color: var(--accent); opacity: 0; transition: opacity 0.3s; }
.journal-saved.show { opacity: 1; }
.journal-container { max-width: 720px; margin: 0 auto; }
.journal-prompt h3 { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.18em; color: var(--accent); margin-bottom: 8px; font-weight: 500; }


/* Comment form */
.comment-form-wrap { max-width: 760px; margin-bottom: 48px; }
.comment-form { background: var(--paper); border: 2px solid var(--ink); padding: 28px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
.comment-form input[type="text"], .comment-form input[type="email"], .comment-form textarea { width: 100%; padding: 12px 14px; border: 1.5px solid var(--ink); background: var(--paper-dark); font-size: 16px; line-height: 1.5; color: var(--ink); resize: vertical; }
.comment-form input:focus, .comment-form textarea:focus { outline: none; border-color: var(--accent-2); background: var(--paper); }
.form-bottom { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 16px; }
.form-hint { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.1em; color: var(--muted); }
.form-submit { padding: 12px 24px; background: var(--ink); color: var(--paper); border: none; font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: all 0.2s; }
.form-submit:hover { background: var(--accent-2); }
.form-submit:disabled { opacity: 0.5; cursor: not-allowed; }
.form-message { margin-top: 16px; padding: 14px 18px; font-size: 15px; line-height: 1.5; display: none; }
.form-message.show { display: block; }
.form-message.success { background: var(--paper-dark); border-left: 3px solid var(--accent); color: var(--ink); }
.form-message.error { background: var(--paper-dark); border-left: 3px solid var(--accent-2); color: var(--accent-2); }
.comments-list { max-width: 760px; }
.comments-loading { color: var(--muted); padding: 14px 0; }
.comment-item { padding: 20px 24px; border-left: 2px solid var(--ink); background: var(--paper); margin-bottom: 14px; transition: border-color 0.2s; }
.comment-item:hover { border-left-color: var(--accent-2); }
.comment-item.is-reply { margin-left: 36px; border-left-color: var(--accent); background: var(--paper-dark); }
.comment-head { display: flex; gap: 12px; align-items: baseline; margin-bottom: 8px; flex-wrap: wrap; }
.comment-name { font-weight: 600; font-size: 16px; }
.comment-time { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.1em; color: var(--muted); }
.comment-body { font-size: 15px; line-height: 1.6; white-space: pre-wrap; }
.comment-actions { margin-top: 8px; }
.comment-reply-btn { background: none; border: none; cursor: pointer; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent-2); padding: 0; }
.comment-reply-btn:hover { text-decoration: underline; }
.reply-indicator { display: inline-block; padding: 4px 10px; background: var(--paper-dark); border: 1px solid var(--ink); font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px; }
.reply-indicator button { background: none; border: none; cursor: pointer; color: var(--accent-2); margin-left: 8px; font-weight: 700; }

.footer { padding: 60px 8% 40px; background: var(--ink); color: var(--paper); text-align: center; }
.footer-quote { font-size: clamp(20px, 2.2vw, 28px); font-weight: 400; line-height: 1.4; max-width: 720px; margin: 0 auto 32px; color: var(--accent); }
.footer-brand { font-size: 28px; font-weight: 500; margin-bottom: 12px; }
.footer-brand .amp { color: var(--accent); font-style: normal; }
.footer p { opacity: 0.7; font-size: 16px; }
.footer-bottom { margin-top: 32px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.2); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.1em; opacity: 0.5; }

@media (max-width: 1024px) {
  .hero { grid-template-columns: 1fr; gap: 48px; padding: 120px 6% 60px; }
  .thesis-grid { grid-template-columns: 1fr; gap: 48px; }
  .fw-grid, .compare-grid { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .nav-bar { padding: 12px 18px; }
  .nav-links { display: none; }
  .section { padding: 64px 6%; }
  .form-row { grid-template-columns: 1fr; }
  .comment-item.is-reply { margin-left: 16px; }
  .chap-row { grid-template-columns: 1fr; }
}

/* ============ FLASHCARDS ============ */
.flashcard-container { perspective: 1500px; margin: 40px auto; max-width: 900px; }
.flashcard-controls { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; font-family: 'JetBrains Mono', monospace; font-size: 13px; }
.flashcard-counter { letter-spacing: 0.1em; }
.flashcard-counter strong { color: var(--accent); font-size: 18px; }
.flashcard { width: 100%; height: 360px; position: relative; transform-style: preserve-3d; transition: transform 0.7s cubic-bezier(0.4, 0.0, 0.2, 1); cursor: pointer; }
